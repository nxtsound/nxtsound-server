# Copy to .env (docker compose reads .env automatically). Do not commit it; it is in .gitignore.

# Display name of the server (UI, linking the app)
APP_NAME=NxtSound

# Default language of the UI and server messages when a user has not chosen one and the browser
# does not state a supported language: en or de. Users can pick their language in their account.
DEFAULT_LANG=en

# Path of the music folder on the host
MUSIC_PATH=./music
# ro = the music folder is mounted read-only (default). rw = plugins that keep songs (an optional plugin setting) save them
# into their own folder in the music folder: MUSIC_PATH/<plugin>/Artist/Album/Title. With ro they go to <data>/imported/<plugin>
# instead (Docker volume; move it with IMPORT_DIR=/path inside the container).
MUSIC_ACCESS=ro
# 0 = scan the library only at startup and via the admin button, otherwise every N minutes
SCAN_MINUTES=0

# Create the admin on first start (only if the database is empty). You can remove both afterwards.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-at-least-8-characters

# Only behind a reverse proxy with HTTPS that sets X-Forwarded-For/-Proto/-Host itself (otherwise leave 0!)
TRUST_PROXY=0
# auto = secure cookie only on HTTPS, true = always
COOKIE_SECURE=auto
# Further allowed origins for state-changing requests, comma-separated (normally empty)
ALLOWED_ORIGINS=

# Lyrics from lrclib.net (0 = off)
LYRICS=1

# Optional
# SESSION_DAYS=30
# A login ends after this many days at the latest, even if it is used all the time (0 = no limit)
# SESSION_MAX_DAYS=180

# Notifications for admins (the bell): a new server version, new versions of plugins installed from a repository, low disk space.
# The server asks GitHub's public API (api.github.com) for the newest release or tag of nxtsound/nxtsound-server; it never updates itself.
# UPDATE_REPO=nxtsound/nxtsound-server   # only change this for a fork
# UPDATE_CHANNEL=stable   # stable = tested releases, beta = also test versions (pre-releases); the admin can switch it in the admin area
# UPDATE_CHECK_HOURS=6    # how often to look for new versions; 0 = never (no request to GitHub at all)
# DISK_WARN_GB=1          # warn below this much free space ...
# DISK_WARN_PERCENT=10    # ... or below this share of the disk

# 1 = analyze new tracks in the background after a scan (tempo, key for the DJ fit), 0 = off
ANALYZE=1
# 1 = DJ transitions are made by the server (a short audio file per transition, kept up to DJ_BRIDGE_MB), 0 = the player blends the songs itself
# DJ_BRIDGES=1
# DJ_BRIDGE_MB=300
# 1 = the singing is separated from the music (needs the stem image, see Dockerfile.stems) and led on its own in DJ transitions
# DJ_STEMS=0
# DJ_STEMS_THREADS=4
# 1 = developer tools: admins see why the server did something (scores of a radio, requests with their timings). Off by default.
# DEVTOOLS=1
# 1 = fetch missing covers, years and artist descriptions from MusicBrainz (also switchable in the admin area), 0 = off
ENRICH=1

# Folder for plugins on the host (put a plugin folder with plugin.json into it, or install via repository address in the admin area)
PLUGINS_PATH=./plugins
# 0 = block installation by repository address in the admin area (plugins then only by hand in the folder)
PLUGIN_REPO_INSTALL=1
# 0 = block installation of plugins by ZIP upload in the admin area
PLUGIN_UPLOAD=1

# Logging (also adjustable in the admin area under System -> Logging, which takes precedence).
# Levels: OFF, ERROR, WARNING, INFO, DEBUG. LOG_LEVEL is the default for the server's own categories;
# the access log, third-party libraries and plugin output have their own defaults (INFO, WARNING, WARNING).
# LOG_LEVEL=INFO
# LOG_ACCESS=1                 # 0 = turn the HTTP access log off
# Per category: LOG_LEVEL_SERVER, LOG_LEVEL_LIBRARY, LOG_LEVEL_ENRICH, LOG_LEVEL_PLUGINS, LOG_LEVEL_PLUGIN_OUTPUT, LOG_LEVEL_OTHER, LOG_LEVEL_ACCESS
# LOG_LEVEL_LIBRARY=DEBUG

# Folder on the host where backups can be kept (mounted at /backups); an NFS share mounted on the host works too
# BACKUP_PATH=./backups
